# Port the API listens on
PORT=5000

# Local MongoDB:      mongodb://127.0.0.1:27017/mizan
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mizan
MONGO_URI=mongodb://127.0.0.1:27017/mizan

# Secret used to sign login tokens. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Only needed if the React app is served from a different domain than the API
# CLIENT_ORIGIN=http://localhost:5173
